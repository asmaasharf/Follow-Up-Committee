        </ul>
    </div>

       <div class="content">
        <div class="title-info">
            <p>لجنة متابعة اداء المراكز التكنولوجية بالمحافظة</p>
            <i class="fas fa-chart-bar"></i>
        </div>
        
        
<div class="content-inquiries">

    <div class="page-header">
        <h2>الاستفسارات</h2>
        <p>تسجيل ومتابعة الاستفسارات الفنية</p>
    </div>

<div class="table-container">

    <table class="table table-bordered inquiry-table">

        <thead>

            <tr>


                <th>المركز</th>

                <th>اسم المستخدم</th>

                <th>الوظيفة</th>

                <th>الاستفسار</th>

                <th>تاريخ الاستفسار</th>

                <th>الرد</th>

                <th>تاريخ الرد</th>

                <th>مسؤول الرد</th>

                <th>الإجراء</th>

            </tr>

        </thead>

        <tbody id="inquiryTable">

{{#each inquiries}}

<tr>


    <td>{{createdBy.city}}</td>

    <td>{{createdBy.username}}</td>

    <td>{{createdBy.jobTitle}}</td>

    <td>

    <div class="text-preview">

