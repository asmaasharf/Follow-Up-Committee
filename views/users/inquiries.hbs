        -
    {{/if}}
</td>

    <td>

        {{#if replyBy}}

            {{replyBy.username}}

        {{else}}

            -

        {{/if}}

    </td>

    <td>

{{#if ../isAdmin}}

<button
class="btn btn-success reply-btn"
data-id="{{_id}}">
تعديل
</button>

{{else}}

{{#if reply}}

-

{{else}}

<button
class="btn btn-success edit-inquiry-btn"
data-id="{{_id}}">
تعديل
</button>

<button
class="btn btn-danger delete-inquiry-btn"
data-id="{{_id}}">
حذف
</button>

{{/if}}

{{/if}}

</td>

</tr>

