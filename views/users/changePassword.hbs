
<link rel="stylesheet" href="/stylesheets/views/users/signin.css">
<link rel="stylesheet" href="/public/stylesheets/style.css">


<div class="change">


<form dir="rtl" action="/users/change-password" method="post">

<h1>تغيير كلمة المرور</h1>


<div class="form-group">
 <label for="inputPassword" class="col-sm-2 col-form-label">كلمة المرور الحالية</label>
  <div class="col-sm-10">
    <input  name="currentPassword" type="password" class="form-control" required>
  </div>
</div>

<div class="form-group">
  <label for="inputPassword" class="col-sm-2 col-form-label">كلمة المرور الجديدة</label>
  <div class="col-sm-10">
    <input   name="newPassword" type="password" class="form-control" required>
  </div>
</div>

<div class="form-group">
  <label for="inputPassword" class="col-sm-2 col-form-label">تأكيد كلمة المرور الجديدة</label>
  <div class="col-sm-10">
    <input  name="confirmPassword" type="password" class="form-control" >
  </div>
</div>



<button type="submit" class="btn btn-success">تغيير كلمة المرور</button>

</form>

</div>