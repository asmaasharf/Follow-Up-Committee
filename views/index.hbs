            <tbody  id="complaintsBody">
                {{#each forms }}
                     <tr>
                        {{!-- زر اختيار --}}
                        <td >
                        <button class="btn-select"
                        data-id = "{{this._id}}"
                        data-city = "{{this.city}}"
                        data-transaction = "{{this.transactionnumber}}"
                        data-service = "{{this.servicecode}}"
                        data-problem = "{{this.problemdescription}}"
                        data-action = "{{this.requiredaction}}"
                        data-image="{{this.image}}"
                        data-adminattachment="{{this.adminAttachment}}"
                        data-adminreply="{{this.adminReply}}"
                        style="background:green; color : white; border : none; padding: 5px 15px; border-radius: 5px; cursor: pointer;"
                        >اختيار</button>

                        </td>
                    <td>{{serialNumber @index ../currentPage 10}}</td>
                    <td>{{formatDate this.createdAt}}</td>
                    <td>{{this.city}}</td>
                    <td><span class="price">{{this.transactionnumber}}</span></td>
                    <td>

                        {{#if this.replyBy}}

                            <span class="count">
                            {{this.replyBy.username}}
                            </span>

                        {{else}}

                            <span class="count">
                                    لم يتم
                            </span>

                        {{/if}}

                    </td>

                    <td>
                    {{#if this.replyDate}}
                         {{formatDate this.replyDate}}
                        {{else}}
                        -
                        {{/if}}
                        </td>

                    <td>

                            {{#ifEquals this.status "تم"}}

                                <span style="color:green;font-weight:bold">
                                            تم
                                </span>

                            {{else}}

                                <span style="color:red;font-weight:bold">
                                        لم يتم
                                </span>

                            {{/ifEquals}}

                        </td>
                </tr>
                {{else}}
                <tr>
                    <td colspan="8">لا توجد بيانات</td>
                </tr>
                {{/each}}
               
            </tbody>
</table>

{{!-- // اظهار زر السابق والتالي  --}}
