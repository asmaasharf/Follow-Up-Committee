<table   id="complaintsTable">
            <thead>
                <tr>
                    <th>الإجراءات</th>
                    <th>رقم القيد</th>
                    <th>التاريخ</th>
                    <th>اسم المركز</th>
                    <th>رقم المعاملة</th>
