<script>

    const complaintsBody = document.getElementById("complaintsBody");

    const isAdmin = {{#if isAdmin}}true{{else}}false{{/if}};
document.getElementById('complaintForm').onsubmit = async function(e) {
    e.preventDefault();
    

    const formData = new FormData();

formData.append('city', this.city.value);
formData.append('transactionnumber', this.transactionnumber.value);
formData.append('servicecode', this.servicecode.value);
formData.append('problemdescription', this.problemdescription.value);
formData.append('requiredaction', this.requiredaction.value);

const image = document.getElementById("image").files[0];

if (image) {
    formData.append("image", image);
}

    try {

    const res = await fetch('/users/submit-form', {
        method: 'POST',
        body: formData
    });

    const result = await res.json();

    // لو السيرفر رجع خطأ
    if (!res.ok || !result.success) {

        alert(result.message);

        return;

    }

    // تنسيق التاريخ
    const createdDate = new Date(result.form.createdAt);

    const date =
        createdDate.getDate() + "-" +
        (createdDate.getMonth() + 1) + "-" +
        createdDate.getFullYear();

    const tbody = document.querySelector("table tbody");

    tbody.insertAdjacentHTML("afterbegin", `
        <tr>
            <td>
                <button
                    class="btn-select"
                    data-id="${result.form._id}"
                    data-city="${result.form.city}"
                    data-transaction="${result.form.transactionnumber}"
                    data-service="${result.form.servicecode}"
                    data-problem="${result.form.problemdescription}"
                    data-action="${result.form.requiredaction}"
                    data-image="${result.form.image}"
                    style="background:green;color:white;border:none;padding:5px 15px;border-radius:5px;cursor:pointer;">
                    اختيار
                </button>
            </td>

            <td>${date}</td>
            <td>${result.form.city}</td>
            <td><span class="price">${result.form.transactionnumber}</span></td>
            <td><span class="count">654</span></td>
            <td><span>تم</span></td>
        </tr>
    `);

    alert("تم الحفظ بنجاح ✅");

    // this.reset();

    window.location.reload();

    document.getElementById("fileButtons").style.display = "none";

} catch (error) {

    console.error(error);

    alert("يوجد مشكلة في الاتصال بالخادم");

}
}

//ارجاع البيانات للفورم بعد الضغط ع اختيار وظهور زر التعديل والحذف للمستخدم

// زرار الاختيار - يملى الفورم
document.addEventListener('click', function(e) {
    if (e.target.classList.contains('btn-select')) {

        
        const btn = e.target;
        
        // املى الفورم بالداتا
        document.getElementById('editId').value = btn.dataset.id;
        document.getElementById('city').value = btn.dataset.city;
        document.getElementById('transactionnumber').value = btn.dataset.transaction;
        document.getElementById('servicecode').value = btn.dataset.service;
        document.getElementById('problemdescription').value = btn.dataset.problem;
        document.getElementById('requiredaction').value = btn.dataset.action;
     



//اضافة صورة من اليوزر

if (btn.dataset.image) {

    const url = "/uploads/" + btn.dataset.image;
    document.getElementById("currentFileName").textContent =
    "الملف الحالي: " + btn.dataset.image;

    document.getElementById("btnView").onclick = () => {

        window.open(url, "_blank");
    };

    document.getElementById("btnDownload").href = url;

    document.getElementById("fileButtons").style.display = "flex";

} else {

    document.getElementById("fileButtons").style.display = "none";

}

// اضافة صورة او ملف الادمن


if (btn.dataset.adminattachment) {

    document.getElementById("adminAttachmentSection").style.display = "block";

    const url = "/uploads/" + btn.dataset.adminattachment;

    document.getElementById("currentAdminFileName").textContent =
        "الملف الحالي: " + btn.dataset.adminattachment;

    document.getElementById("btnViewAdmin").onclick = () => {
        window.open(url, "_blank");
    };

    document.getElementById("btnDownloadAdmin").href = url;

    document.getElementById("adminFileButtons").style.display = "flex";

} else {

    if (!isAdmin) {
        document.getElementById("adminAttachmentSection").style.display = "none";
    }

}

        
 // غيري شكل الفورم
        
if (isAdmin) {

    const adminReplyBox = document.getElementById("adminReplyBox");

    if (adminReplyBox) {

        adminReplyBox.style.display = "block";

        document.getElementById("adminReply").value =

            btn.dataset.adminreply || "";

            if (btn.dataset.adminreply) {

    document.getElementById("btnReply").textContent = "تعديل الرد";

    document.getElementById("adminReply").readOnly = true;

    const adminAttachment = document.getElementById("adminAttachment");

    if (adminAttachment) {
        adminAttachment.disabled = true;
    }

    isReplyEditing = false;

} else {

    document.getElementById("btnReply").textContent = "حفظ الرد";

    document.getElementById("adminReply").readOnly = false;

    const adminAttachment = document.getElementById("adminAttachment");

    if (adminAttachment) {
        adminAttachment.disabled = false;
    }

    isReplyEditing = false;
}

            

     if (btn.dataset.adminreply) {
        document.getElementById("btnReply").textContent = "تعديل الرد";
} else {
        document.getElementById("btnReply").textContent = "حفظ الرد";
}
    }

    // نخفي صندوق عرض الرد الخاص باليوزر
    document.getElementById("userReplyBox").style.display = "none";

    document.getElementById('btnSubmit').style.display = 'none';

    document.getElementById('btnReply').style.display = 'inline-block';

    document.getElementById('btnDelete').style.display = 'none';

    document.getElementById('btnCancel').style.display = 'inline-block';

} else {

    const adminReplyBox = document.getElementById("adminReplyBox");

    if (adminReplyBox) {
        adminReplyBox.style.display = "none";
    }

    // لو فيه رد من الأدمن اعرضه لليوزر
    if (btn.dataset.adminreply) {

        document.getElementById("userReplyBox").style.display = "block";

        document.getElementById("userReply").value =
            btn.dataset.adminreply;

    } else {

        document.getElementById("userReplyBox").style.display = "none";

        document.getElementById("userReply").value = "";

    }

    if (btn.dataset.adminreply) {

    document.getElementById("userReplyBox").style.display = "block";
    document.getElementById("userReply").value = btn.dataset.adminreply;

    // ممنوع التعديل بعد الرد
    document.getElementById("btnUpdate").style.display = "none";
    document.getElementById("btnDelete").style.display = "none";

} else {

    document.getElementById("userReplyBox").style.display = "none";
    document.getElementById("userReply").value = "";

    // مسموح بالتعديل قبل الرد
    document.getElementById("btnUpdate").style.display = "inline-block";
    document.getElementById("btnDelete").style.display = "inline-block";

}

document.getElementById("btnCancel").style.display = "inline-block";
document.getElementById("btnSubmit").style.display = "none";

}
        // رجوع لوضع التعديل الطبيعي
        isEditing = false;
        document.getElementById('btnUpdate').textContent = 'تعديل';

disableForm() // فانكشن علشان الفورم يكون غير قابل للكتابة فيه قبل الضغط ع زر التعديل

        // اعملي scroll للفورم
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
});

// زرار إلغاء - يرجع الفورم لوضعه الطبيعي
document.getElementById('btnCancel').onclick = function() {
    document.getElementById('complaintForm').reset();
    enableForm();

isEditing = false;

document.getElementById("btnUpdate").textContent = "تعديل";
document.getElementById("btnUpdate").style.width = "120px";
    document.getElementById('editId').value = '';
    document.getElementById('btnSubmit').style.display = 'inline-block';
    const btnReply = document.getElementById('btnReply');

if (btnReply) {
    btnReply.style.display = 'none';
}
    document.getElementById('btnDelete').style.display = 'none';
    document.getElementById('btnCancel').style.display = 'none';
    document.getElementById("fileButtons").style.display = "none";
    document.getElementById("btnUpdate").style.display = "none";
    document.getElementById("currentFileName").textContent = "";

    // إخفاء صندوق عرض رد الأدمن
const userReplyBox = document.getElementById("userReplyBox");
if (userReplyBox) {
    userReplyBox.style.display = "none";
}

// مسح نص رد الأدمن
const userReply = document.getElementById("userReply");
if (userReply) {
    userReply.value = "";
}

// إخفاء أزرار مرفقات الرد
const adminFileButtons = document.getElementById("adminFileButtons");
if (adminFileButtons) {
    adminFileButtons.style.display = "none";
}

// مسح اسم مرفق الرد
const currentAdminFileName = document.getElementById("currentAdminFileName");
if (currentAdminFileName) {
    currentAdminFileName.textContent = "";
}

    if (isAdmin) {

    document.getElementById("adminReplyBox").style.display = "none";

   const adminReply = document.getElementById("adminReply");

if (adminReply) {
    adminReply.value = "";
}

}

if (!isAdmin) {

    const section = document.getElementById("adminAttachmentSection");

    if (section) {
        section.style.display = "none";
    }

}

// رجوع الفورم لوضع الإضافة
document.getElementById("btnSubmit").style.display = "inline-block";
document.getElementById("btnUpdate").style.display = "none";
document.getElementById("btnDelete").style.display = "none";
document.getElementById("btnCancel").style.display = "none";


};

// زرار التعديل

let isEditing = false;

document.getElementById('btnUpdate').onclick = async function () {
   
    // أول ضغطة: دخول وضع التعديل
    if (!isEditing) {

        isEditing = true;

        this.textContent = "حفظ التعديلات";

        document.getElementById('btnDelete').style.display = "none";
        this.style.width = "170px"
        enableForm();// فانشكن علشان لما اضغط تعديل يكون متاح الكتابة ف الفورم 

        return;
    }

   
  // ثاني ضغطة: حفظ التعديلات
const id = document.getElementById('editId').value;

const formData = new FormData();

formData.append("city", document.getElementById("city").value);
formData.append("transactionnumber", document.getElementById("transactionnumber").value);
formData.append("servicecode", document.getElementById("servicecode").value);
formData.append("problemdescription", document.getElementById("problemdescription").value);
formData.append("requiredaction", document.getElementById("requiredaction").value);

// لو اختار صورة جديدة
const image = document.getElementById("image").files[0];

if (image) {
    formData.append("image", image);
}

try {

    const res = await fetch(`/users/update-complaint/${id}`, {
        method: "PUT",
        body: formData
    });

    const result = await res.json();

    console.log("Update response:", res.status, result);

if (!res.ok || !result.success) {

    alert(result.message || "غير مصرح لك بالتعديل");

    // إرجاع الفورم للوضع الطبيعي
    document.getElementById('btnCancel').click();

    return;
}


    // لو التعديل تم بنجاح
    alert(result.message || "تم التعديل بنجاح");

    isEditing = false;

    this.textContent = "تعديل";

    this.style.width = "120px";

    document.getElementById("btnDelete").style.display = "inline-block";

    window.location.reload();


} catch (error) {

    console.error("Update error:", error);

    alert("حدث خطأ أثناء محاولة التعديل");

}



}
// زرار الحذف
document.getElementById('btnDelete').onclick = async function() {
    const id = document.getElementById('editId').value;
    if(confirm('هل انت متأكد من الحذف؟')) {
        const res = await fetch(`/users/delete-complaint/${id}`, {
            method: 'DELETE'
        });
        const result = await res.json();
        if(result.success){

    alert('تم الحذف ✅');

    window.location.reload();

}else{

    alert(result.message);

}
    }
};


// زر حفظ رد الأدمن
const btnReply = document.getElementById('btnReply');

if (btnReply) {

    btnReply.onclick = async function () {

         // لو فيه رد سابق اضغطة أولى تدخل وضع التعديل فقط
    if (this.textContent === "تعديل الرد" && !isReplyEditing) {

        isReplyEditing = true;

        this.textContent = "حفظ التعديلات";

        this.style.width = "170px";

        document.getElementById("adminReply").readOnly = false;

        const adminAttachment = document.getElementById("adminAttachment");

        if (adminAttachment) {
            adminAttachment.disabled = false;
        }

        return; // يقف هنا وميروحش يحفظ
    }

        const id = document.getElementById('editId').value;

        const adminReply = document.getElementById('adminReply').value;

        if (adminReply.trim() === "") {

            alert("من فضلك اكتب الإجراءات المتخذة");

            return;
        }

        const formData = new FormData();

        formData.append("adminReply", adminReply);

        const adminAttachment =
            document.getElementById("adminAttachment").files[0];

        if (adminAttachment) {

            formData.append("adminAttachment", adminAttachment);

        }

        const isEdit = isReplyEditing;

        const res = await fetch(`/users/reply-complaint/${id}`, {

            method: "PUT",

            body: formData

        });

        const result = await res.json();

        if (result.success) {

    if (isEdit) {
        alert("تم تعديل الرد بنجاح");
    } else {
        alert("تم حفظ الرد بنجاح");
    }

    window.location.reload();

} else {

    alert(result.message);

}

    };

}



// فانكشن علشان الفورم يكون غير قابل للكتابة فيه قبل الضغط ع زر التعديل
function disableForm() {

    document.getElementById('city').disabled = true; // لأنها select

    document.getElementById('transactionnumber').readOnly = true;
    document.getElementById('servicecode').readOnly = true;
    document.getElementById('problemdescription').readOnly = true;
    document.getElementById('requiredaction').readOnly = true;
    
}
// فانشكن علشان لما اضغط تعديل يكون متاح الكتابة ف الفورم 
function enableForm() {

    document.getElementById('city').disabled = false;

    document.getElementById('transactionnumber').readOnly = false;
    document.getElementById('servicecode').readOnly = false;
    document.getElementById('problemdescription').readOnly = false;
    document.getElementById('requiredaction').readOnly = false;
    
}

//عرض الصوره ف الفورم بالازرار

  // عرض الملف المختار
const imageInput = document.getElementById("image");

imageInput.addEventListener("change", function () {

    const file = this.files[0];

    if (!file) {
        document.getElementById("fileButtons").style.display = "none";
        return;
    }

    const url = URL.createObjectURL(file);

    document.getElementById("btnView").onclick = () => {
        window.open(url, "_blank");
    };

    document.getElementById("btnDownload").href = url;

    document.getElementById("fileButtons").style.display = "flex";

});



// البحث برقم المعاملة

const btnSearch = document.getElementById("btnSearch");
const searchInput = document.getElementById("searchInput");

btnSearch.addEventListener("click", function () {

    const transactionnumber = searchInput.value.trim();

    if (transactionnumber === "") {

        alert("من فضلك أدخل رقم المعاملة");

        return;

    }

    fetch(`/users/search?transactionnumber=${encodeURIComponent(transactionnumber)}`)

    .then(res => res.json())

    .then(data => {

        console.log(data);

        if (!data.success) {

            alert(data.message);

            return;

        }


        // مسح النتائج القديمة
        complaintsBody.innerHTML = "";


        // كل الشكاوى الخاصة بنفس رقم المعاملة
        data.complaints.forEach((complaint, index) => {


            // رقم القيد الخاص بنتيجة البحث
            // يبدأ من 1 في كل عملية بحث
            const registrationNumber = index + 1;


            const row = document.createElement("tr");


            row.innerHTML = `

                <td>

                    <button
                        class="btn-select"
                        data-id="${complaint._id}"
                        data-city="${complaint.city}"
                        data-transaction="${complaint.transactionnumber}"
                        data-service="${complaint.servicecode}"
                        data-problem="${complaint.problemdescription}"
                        data-action="${complaint.requiredaction}"
                        data-image="${complaint.image || ""}"
                        data-adminattachment="${complaint.adminAttachment || ""}"
                        data-adminreply="${complaint.adminReply || ""}"

                        style="
                            background:green;
                            color:white;
                            border:none;
                            padding:5px 15px;
                            border-radius:5px;
                            cursor:pointer;
                        ">

                        اختيار

                    </button>

                </td>


                <!-- رقم القيد في نتيجة البحث -->
                <td>${registrationNumber}</td>


                <!-- التاريخ -->
                <td>
                    ${new Date(complaint.createdAt).toLocaleDateString("en-GB")}
                </td>


                <!-- اسم المركز -->
                <td>
                    ${complaint.city}
                </td>


                <!-- رقم المعاملة -->
                <td>
                    ${complaint.transactionnumber}
                </td>


                <!-- مسؤول الرد -->
                <td>

                    ${
                        complaint.replyBy
                        ? `<span class="count">${complaint.replyBy.username}</span>`
                        : `<span class="count">لم يتم</span>`
                    }

                </td>


                <!-- تاريخ الرد -->
                <td>

                    ${
                        complaint.replyDate
                        ? new Date(complaint.replyDate).toLocaleDateString("en-GB")
                        : "-"
                    }

                </td>


                <!-- حالة الرد -->
                <td>

                    ${
                        complaint.status === "تم"

                        ? `<span style="color:green;font-weight:bold">
                                تم
                           </span>`

                        : `<span style="color:red;font-weight:bold">
                                لم يتم
                           </span>`
                    }

                </td>

            `;


            complaintsBody.appendChild(row);

        });


        // تفريغ خانة البحث
        searchInput.value = "";


        // النزول للجدول
        document.getElementById("complaintsTable").scrollIntoView({

            behavior: "smooth"

        });

    })


    .catch(err => {

        console.error(err);

        alert("حدث خطأ أثناء البحث");

    });

});


  




